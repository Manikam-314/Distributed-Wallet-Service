public String acquireLock(Long walletId) {
    String key = LOCK_PREFIX + walletId;           // "lock:wallet:5"
    String lockValue = UUID.randomUUID().toString(); // unique owner ID
    
    Boolean success = redisTemplate.opsForValue().setIfAbsent(
            key, lockValue, 10, TimeUnit.SECONDS   // SET NX EX 10
    );
    
    if (Boolean.TRUE.equals(success)) return lockValue;
    return null;  // LOCK FAILED — no retry
}
