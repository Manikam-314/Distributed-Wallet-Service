public void releaseLock(Long walletId, String lockValue) {
    String luaScript =
        "if redis.call('get', KEYS[1]) == ARGV[1] then " +
            "return redis.call('del', KEYS[1]) " +
        "else return 0 end";
    // Atomic compare-and-delete via Lua → prevents releasing someone else's lock
}
